         (detect-only-hostile-forces False)
         (detect-own-force False)
         (object-types-to-detect 
            (object-type  1 (1 -1 -1 -1 -1 -1 -1))
            (object-type  1 (5 1 225 2 1 1 0))
            (object-type  1 (5 1 225 9 1 1 1))
            (object-type  1 (5 1 225 5 9 2 1))
            (object-type  1 (9 1 225 1 1 0 0))
            (object-type  1 (3 -1 -1 -1 -1 -1 -1))
