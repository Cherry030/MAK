(human 
   (parameter-type "human-param")
   (bounding-geometry-type Volume)
   (bounding-volume $bounding-volume)
   (articulated-parts $articulated-parts) 
   (formation "Other")
   (default-appearance        0)
   (force ForceOther)
   (category $short-name)
   (echelon-level "")
   (is-organized True)
   (min-tick-period 0.000000)
   (min-tick-period-variance 0.000000)
   (dr-algorithm Rvw)
   (navigation-parameters 
      (DtRwString navigation-profile "lifeform")
      (DtRwString navigation-method "shortcut")
      (DtRwBoolean collidable-when-destroyed False)
      (DtRwBoolean use-abstract-graph False)
      (DtRwReal min-abstract-graph-replan-distance 100.000000)
      (DtRwReal propagation-box-extent 200.000000)
      (DtRwBoolean enable-avoidance True)
      (DtRwBoolean avoidance-enable-stop False)
      (DtRwBoolean avoidance-enable-slow-down True)
      (DtRwBoolean avoidance-enable-push-through False)
      (DtRwReal avoidance-collision-lookahead-time 8.000000)
      (DtRwReal avoidance-collision-detection-radius 15.000000)
      (DtRwReal avoidance-angle-eval-span 190.000000)
      (DtRwInt avoidance-num-angle-samples 35)
      (DtRwReal avoidance-safety-distance 0.200000)
      (DtRwReal avoidance-collision-influence 0.800000)
      (DtRwBoolean enable-navigation $enable-navigation (default True))
      (DtRwReal radius-factor 1.1)
   )
   (dr-thresholds 
      (translation 0.250000)
      (rotation 3.000000)
      (aggregate-dimension 0.050000)
   )
   (dr-allow-gui-overrides True)
   (radios 
      (main-radio 
         (radio-descriptor-type "radio-descriptor")
         (radio-type "default-radio")
         (comm-model-name "default-radio-model")
         (publish-transmitter True)
         (transmitter-params 
            (radio-type  7 1 225 2 1 20)
            (initial-frequency 3000000.000000)
            (power 30.000000)
         )
         (sample-rate 1000000.000000)
      )
   )
   (systems )
